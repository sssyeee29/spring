<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.sample.mapper.MemberMapper">
	
	<resultMap type="org.sample.domain.MemberVO" id="memberMap">
		<id property="userid" column="userid"/> <!-- 기본키 -->
		
		<!-- property는 MemberVO랑 이름이 맞아야하고, column은 DB에서 쓴거랑 같아야함 -->
		<result property="userid" column="userid"/>
		<result property="userpw" column="userpw"/>
		<result property="userName" column="username"/>
		<result property="regDate" column="regdate"/>
		<result property="updateDate" column="updatedate"/>
		
		<collection property="authList" resultMap="authMap" ofType="org.sample.domain.AuthVO">
		</collection>
	</resultMap>
	
	<resultMap type="org.sample.domain.AuthVO" id="authMap">
		<result property="userid" column="userid"/>
		<result property="auth" column="auth"/>
	</resultMap>
	
	<select id="read" resultMap="memberMap">
		
		select
			mem.userid, userpw, username, enabled, regdate, updatedate, auth
		from 
			tbl_member mem left outer join tbl_member_auth auth
		on
			mem.userid = auth.userid
		where
			mem.userid = #{userid}
		
	</select>
	

</mapper>












